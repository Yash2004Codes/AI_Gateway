# ─────────────────────────────────────────────
# AI Gateway - Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://gateway:gateway_secret@localhost:5432/ai_gateway
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway_secret
POSTGRES_DB=ai_gateway

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# LLM Provider API Keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GEMINI_API_KEY=your-gemini-key-here

# Rate Limiting
GLOBAL_TPM_LIMIT=100000
DEFAULT_TENANT_TPM_LIMIT=10000

# Queue Configuration
WORKER_CONCURRENCY=5
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY=1000

# Mock mode: simulate LLM responses so the whole pipeline runs without vendor keys
LLM_MOCK_MODE=false
LLM_MOCK_FAILURE_RATE=0
